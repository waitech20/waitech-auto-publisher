# WaiTech Auto Publisher — environment variables
#
# Local setup: copy this file to ".env" and fill in real values.
# NEVER commit the real ".env" file (it is already in .gitignore).
#
# Cloud (GitHub Actions) setup: set these as repository Secrets under
# Settings -> Secrets and variables -> Actions, NOT in a committed file.

# REQUIRED
# Buffer API access token. Rotate immediately if it is ever exposed.
# https://buffer.com/developers/api
BUFFER_ACCESS_TOKEN=your_buffer_access_token_here

# OPTIONAL
# Buffer channel/profile ID to publish to.
# Defaults to the WaiTech Solution Facebook channel if not set.
BUFFER_CHANNEL_ID=6a7de7afb2d9d577436e52b5

# OPTIONAL
# Blogger RSS feed URL to monitor.
# Defaults to https://waitechsolution.blogspot.com/feeds/posts/default?alt=rss
BLOGGER_RSS=https://waitechsolution.blogspot.com/feeds/posts/default?alt=rss

# OPTIONAL
# Set to "true" to run the publisher without sending anything to Buffer
# and without writing to the publication database. Defaults to "false".
DRY_RUN=false

# OPTIONAL — local scheduler.js only, ignored by the cloud workflow
# How often (in minutes) the local scheduler checks for new posts.
SCHEDULER_INTERVAL_MINUTES=5
